# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# GM1 Voice GCL. These deliberately default to unavailable; there is no provider
# key, provider URL, or live-enable flag in this feature branch.
GCL_OWNER_TOKEN="replace-with-owner-secret"
GCL_VOICE_SYNTHETIC_ENABLED=false
GCL_VOICE_LIVE_DISABLED=true
GCL_VOICE_MAX_COST_CENTS=25
GCL_VOICE_MAX_INPUT_CHARACTERS=240
GCL_VOICE_MAX_AUDIO_DURATION_MS=30000
GCL_VOICE_DAILY_RUN_QUOTA=10
GCL_VOICE_DAILY_ITEM_QUOTA=10
