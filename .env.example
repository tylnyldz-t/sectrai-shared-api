# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# GM2 camera observation is fixture-only and fail-closed. These are local
# governance placeholders, never camera, provider, stream, or device secrets.
GCL_OWNER_TOKEN="replace-with-owner-secret"
GCL_CAMERA_SYNTHETIC_ENABLED=false
# Permanently unsupported: true is rejected with CAMERA_LIVE_DISABLED.
GCL_CAMERA_LIVE_ENABLED=false
GCL_CAMERA_MAX_COST_CENTS=25
GCL_CAMERA_MAX_ITEMS=1
GCL_CAMERA_DAILY_RUN_QUOTA=10
GCL_CAMERA_DAILY_OBSERVATION_QUOTA=10
