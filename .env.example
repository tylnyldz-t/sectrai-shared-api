# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# GM2 Vision/OCR is synthetic-only. These are governance settings, not provider
# credentials. Leave every value unset outside a deliberately owner-gated demo.
GCL_OWNER_TOKEN="replace-with-owner-secret"
GCL_VISION_SYNTHETIC_ENABLED=false
# Permanently unsupported: true is rejected with VISION_LIVE_DISABLED.
GCL_VISION_LIVE_ENABLED=false
GCL_VISION_MAX_COST_CENTS=25
GCL_VISION_MAX_ITEMS=1
GCL_VISION_DAILY_RUN_QUOTA=10
GCL_VISION_DAILY_SCAN_QUOTA=10
