# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# GM5/GM6 GCL: exactly LIVE_DISABLED is accepted. These values are governance
# limits only; do not put engine, GPU, provider, or API credentials here.
GCL_OWNER_TOKEN="replace-with-owner-gate-secret"
GCL_3D_LIVE_MODE="LIVE_DISABLED"
GCL_3D_MAX_COST_CENTS=100
GCL_3D_MAX_ITEMS=1
GCL_3D_DAILY_RUN_QUOTA=10
GCL_3D_DAILY_ITEM_QUOTA=10
GCL_GAME_ENGINE_LIVE_MODE="LIVE_DISABLED"
GCL_GAME_ENGINE_MAX_COST_CENTS=250
GCL_GAME_ENGINE_MAX_GPU_MINUTES=30
GCL_GAME_ENGINE_DAILY_RUN_QUOTA=10
GCL_GAME_ENGINE_DAILY_GPU_MINUTE_QUOTA=120
