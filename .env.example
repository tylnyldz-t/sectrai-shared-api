# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# GM6 Governed Connector Layer. This is an owner-gate secret, not a provider
# credential. Real engine, GPU, cloud, or API credentials are never accepted.
GCL_OWNER_TOKEN="replace-with-owner-secret"
# LIVE_DISABLED is hard-coded in the adapter. Setting this to true is rejected.
GCL_GAME_ENGINE_LIVE_ENABLED=false
GCL_GAME_ENGINE_MAX_COST_CENTS=250
GCL_GAME_ENGINE_MAX_GPU_MINUTES=30
GCL_GAME_ENGINE_DAILY_RUN_QUOTA=10
GCL_GAME_ENGINE_DAILY_GPU_MINUTE_QUOTA=120
