# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# Governed Connector Layer: keep every value below unset in local/default deploys.
# Never commit a real owner token.
GCL_OWNER_TOKEN="replace-with-owner-secret"

# GM4 video connectors are synthetic-only. `true` deliberately fails closed;
# no provider endpoint, credential, or live execution path exists in this API.
GCL_VIDEO_LIVE_ENABLED=false
GCL_VIDEO_MAX_COST_CENTS=50
GCL_VIDEO_MAX_ITEMS=2
GCL_VIDEO_MAX_DURATION_SECONDS=30
GCL_VIDEO_MAX_PROMPT_CHARACTERS=2000
GCL_VIDEO_DAILY_RUN_QUOTA=10
GCL_VIDEO_DAILY_ITEM_QUOTA=20
GCL_VIDEO_QUEUE_MAX_QUEUED_JOBS=25
