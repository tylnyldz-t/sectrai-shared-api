# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# Synthetic interpreter GCL. These deliberately default to unavailable. There
# is no provider key, provider URL, or live-enable flag in this module. Do not
# add GCL_TRANSLATION_LIVE_ENABLED: its presence (even "false") poisons the
# connector and keeps it unavailable.
GCL_OWNER_TOKEN="replace-with-owner-secret"
GCL_TRANSLATION_SYNTHETIC_ENABLED=false
GCL_TRANSLATION_LIVE_DISABLED=true
GCL_TRANSLATION_MAX_COST_CENTS=25
GCL_TRANSLATION_MAX_INPUT_CHARACTERS=1000
GCL_TRANSLATION_MAX_AUDIO_DURATION_MS=30000
GCL_TRANSLATION_REVIEW_TTL_MS=900000
GCL_TRANSLATION_DAILY_RUN_QUOTA=10
GCL_TRANSLATION_DAILY_ITEM_QUOTA=10
