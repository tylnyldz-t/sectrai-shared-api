# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# GM2 document-field extraction is synthetic-only. These limits do not enable
# camera/OCR/provider execution and do not contain any credential.
GCL_VISION_LIVE_MODE="LIVE_DISABLED"
GCL_VISION_MAX_COST_CENTS=20
GCL_VISION_MAX_ITEMS=1
GCL_VISION_MAX_REVIEW_AGE_SECONDS=3600
GCL_VISION_MAX_EVIDENCE_AGE_SECONDS=3600
GCL_VISION_DAILY_RUN_QUOTA=5
GCL_VISION_DAILY_ITEM_QUOTA=5
