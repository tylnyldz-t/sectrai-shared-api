# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# Synthetic interpreter GCL. These deliberately default to unavailable. There
# is no provider key, provider URL, or live-enable flag in this module. Do not
# add GCL_TRANSLATION_LIVE_ENABLED: its presence (even "false") poisons the
# connector and keeps it unavailable.
GCL_OWNER_TOKEN="replace-with-owner-secret"
GCL_TRANSLATION_SYNTHETIC_ENABLED=false
GCL_TRANSLATION_LIVE_DISABLED=true
GCL_TRANSLATION_MAX_COST_CENTS=25
GCL_TRANSLATION_MAX_INPUT_CHARACTERS=1000
GCL_TRANSLATION_MAX_AUDIO_DURATION_MS=30000
GCL_TRANSLATION_REVIEW_TTL_MS=900000
GCL_TRANSLATION_DAILY_RUN_QUOTA=10
GCL_TRANSLATION_DAILY_ITEM_QUOTA=10

# GM2 document-field extraction is synthetic-only. These limits do not enable
# camera/OCR/provider execution and do not contain any credential.
GCL_VISION_LIVE_MODE="LIVE_DISABLED"
GCL_VISION_MAX_COST_CENTS=20
GCL_VISION_MAX_ITEMS=1
GCL_VISION_MAX_REVIEW_AGE_SECONDS=3600
GCL_VISION_MAX_EVIDENCE_AGE_SECONDS=3600
GCL_VISION_DAILY_RUN_QUOTA=5
GCL_VISION_DAILY_ITEM_QUOTA=5

# GM2 camera observation is fixture-only and fail-closed. These are local
# governance placeholders, never camera, provider, stream, or device secrets.
GCL_CAMERA_SYNTHETIC_ENABLED=false
# Permanently unsupported: true is rejected with CAMERA_LIVE_DISABLED.
GCL_CAMERA_LIVE_ENABLED=false
GCL_CAMERA_MAX_COST_CENTS=25
GCL_CAMERA_MAX_ITEMS=1
GCL_CAMERA_DAILY_RUN_QUOTA=10
GCL_CAMERA_DAILY_OBSERVATION_QUOTA=10

# Synthetic market connector: it accepts no credential and cannot make calls.
# Only this exact lowercase value permits the synthetic proposal path.
GCL_MARKET_LIVE_ENABLED=false
GCL_MARKET_MAX_COST_CENTS=50
GCL_MARKET_MAX_ITEMS=10
GCL_MARKET_MAX_CAPACITY_UNITS=10
GCL_MARKET_DAILY_RUN_QUOTA=10
GCL_MARKET_DAILY_ITEM_QUOTA=20

# GM3 text-to-image is local synthetic review material only. Never add a
# provider credential, endpoint, Docker switch, or live-enable flag.
GCL_IMAGE_LIVE_MODE=LIVE_DISABLED
GCL_IMAGE_MAX_COST_CENTS=25
GCL_IMAGE_MAX_ITEMS=2
GCL_IMAGE_OWNER_REVIEW_TTL_SECONDS=900
GCL_IMAGE_DAILY_RUN_QUOTA=10
GCL_IMAGE_DAILY_ITEM_QUOTA=20

# GM5/GM6 3D and game connectors emit review plans only. These are governance
# limits, never provider, engine, GPU, executable, endpoint, or API settings.
GCL_3D_LIVE_MODE=LIVE_DISABLED
GCL_3D_MAX_COST_CENTS=100
GCL_3D_MAX_ITEMS=1
GCL_3D_DAILY_RUN_QUOTA=10
GCL_3D_DAILY_ITEM_QUOTA=10
GCL_GAME_ENGINE_LIVE_MODE=LIVE_DISABLED
GCL_GAME_ENGINE_MAX_COST_CENTS=250
GCL_GAME_ENGINE_MAX_GPU_MINUTES=30
GCL_GAME_ENGINE_DAILY_RUN_QUOTA=10
GCL_GAME_ENGINE_DAILY_GPU_MINUTE_QUOTA=120
