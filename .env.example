# Never commit a real Neon connection string or API key.
DATABASE_URL="postgresql://..."
PORT=8789
# Product keys are fail-closed. Add one key per deployed demo product.
SHARED_API_KEY_HEALTH="replace-with-strong-key"

# Synthetic market connector: it accepts no credential and cannot make calls.
# Only this exact lowercase value permits the synthetic connector. Missing,
# true, uppercase, or malformed values close it; none can enable a provider.
GCL_MARKET_LIVE_ENABLED=false
GCL_MARKET_MAX_COST_CENTS=50
GCL_MARKET_MAX_ITEMS=10
GCL_MARKET_MAX_CAPACITY_UNITS=10
GCL_MARKET_DAILY_RUN_QUOTA=10
GCL_MARKET_DAILY_ITEM_QUOTA=20

# Governed Connector Layer: keep every value below unset in local/default deploys.
# Never commit a real owner token.
GCL_OWNER_TOKEN="replace-with-owner-secret"
