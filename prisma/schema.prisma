generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Record {
  id          String   @id @default(cuid())
  product     String
  workspaceId String
  moduleId    String
  values      Json
  status      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String

  @@index([product, workspaceId, moduleId, createdAt])
  @@index([product, workspaceId, moduleId, id])
  @@map("sectrai_demo_records")
}
